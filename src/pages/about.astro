---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>About Me</h1>
			<p>
				I am a Computer Science & Econometrics student at <strong>AGH University of Krakow</strong> with a solid technical foundation in data analysis, relational databases, and Python programming.
			</p>

			<h2>Education</h2>
			<div class="skill-category" style="margin-bottom: 1rem;">
				<h3>AGH University of Krakow</h3>
				<p style="margin: 0.25rem 0; color: var(--text-main); font-weight: 600;">B.Sc. in Computer Science & Econometrics</p>
				<p style="margin: 0; font-size: 0.85rem;" class="stat-label">10/2025 – 06/2028 | Kraków, Poland</p>
				<p style="margin-top: 0.5rem; font-size: 0.95rem;">
					Focus areas: Statistics, Programming, Econometrics, Relational Databases, Data Analysis, and Git version control.
				</p>
			</div>

			<h2>Get In Touch</h2>
			<p>
				I am currently actively looking for <strong>Internship or Junior-level opportunities</strong> in Data Analysis, Data Engineering, or Data Science.
			</p>

			<div class="cta-buttons" style="margin-top: 1.5rem;">
				<a href="mailto:patrykstec1001@gmail.com" class="btn-primary">
					✉️ Email Me
				</a>
				<a href="https://www.linkedin.com/in/patryk-stec%F0%9F%A8%AA8aa8b4332" target="_blank" class="btn-secondary">
					💼 LinkedIn
				</a>
				<a href="https://github.com/patryks-arch" target="_blank" class="btn-secondary">
					⚡ GitHub
				</a>
			</div>
		</main>
		<Footer />
	</body>
</html>